{
  "manifest_version": 3,
  "name": "Zoho Monthly Autofill",
  "version": "1.0.2",
  "description": "Fill hours and a global description in the open Monthly Log for manual review and saving.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zoho Monthly Autofill",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "author": "Franco Rosatto <francoe12012@gmail.com>",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
